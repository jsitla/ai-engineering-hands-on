# Copy this file to .env and change what you need.

# Which AI to use: ollama (free, local), openai or anthropic
PROVIDER=ollama

# Optional: override the default model for that provider
# MODEL=llama3.2:3b

# Only needed for the paid APIs. Never share or commit your real keys!
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
